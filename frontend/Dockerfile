# 1. Беремо офіційний базовий образ з Node.js (версія 20)
FROM node:20-alpine

# 2. Встановлюємо робочу директорію всередині контейнера
WORKDIR /app

# 3. Копіюємо файли конфігурації залежностей
COPY package*.json ./

# 4. Встановлюємо залежності
RUN npm install

# 5. Копіюємо весь інший код фронтенду
COPY . .

# 6. Відкриваємо порт 3000, на якому працює Next.js
EXPOSE 3000

# 7. Команда для запуску додатка у режимі розробки
CMD ["npm", "run", "dev"]